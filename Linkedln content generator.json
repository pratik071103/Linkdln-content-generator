        "jsCode": "// 1️⃣ Safely extract Telegram reply\nconst selectedText =\n  $json?.data?.text ||\n  $json?.text ||\n  $json?.message?.text ||\n  null;\n\n// 2️⃣ Parse numeric selection\nconst selectedNumber = parseInt(selectedText, 10);\n\n// 3️⃣ Collect all articles from Clean Gemini Output (each item = 1 article)\nconst articles = $items(\"Clean Gemini Output\").map(item => item.json);\n\n// 4️⃣ Validate input\nif (!Array.isArray(articles) || isNaN(selectedNumber) || selectedNumber < 1 || selectedNumber > articles.length) {\n  return [\n    {\n      json: {\n        error: \"Invalid selection or number out of range\",\n        selectedNumber,\n        articlesLength: Array.isArray(articles) ? articles.length : 0,\n      },\n    },\n  ];\n}\n\n// 5️⃣ Get selected article\nconst selectedArticle = articles[selectedNumber - 1];\n\n// 6️⃣ Return structured result\nreturn [\n  {\n    json: {\n      selectedNumber,\n      selectedArticle,\n    },\n  },\n];\n"
      },
