      "parameters": {
        "jsCode": "let content = $json.output || $json;          // Gemini sometimes nests text in \"output\"\nif (typeof content === \"string\") {\n  const match = content.match(/\\[[\\s\\S]*\\]/);\n  content = match ? match[0] : content;\n}\nlet list;\ntry {\n  list = JSON.parse(content);\n} catch (err) {\n  throw new Error(\"Output is not valid JSON: \" + err.message);\n}\nreturn list.map(i => ({\n  json: {\n    rank: i.rank,\n    title: i.title,\n    summary: i.summary,\n    url: i.url\n  }\n}));\n"
